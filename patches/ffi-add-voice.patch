+/// Load the voice file at `path` (a voice embedding, `*.safetensors`) as `name`, replacing any
+/// voice of that name, so voices can be added without reloading the model. Returns false on
+/// failure; see `ptts_last_error`. Not on Apple, whose bundles carry their voices.
+///
+/// # Safety
+/// `h` must come from `ptts_new`; `name` and `path` must be NUL-terminated UTF-8.
+#[cfg(not(target_vendor = "apple"))]
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn ptts_add_voice(
+    h: *mut PttsHandle,
+    name: *const c_char,
+    path: *const c_char,
+) -> bool {
+    let h = unsafe { &mut *h };
+    let name = unsafe { CStr::from_ptr(name) }.to_string_lossy().to_string();
+    let path = unsafe { CStr::from_ptr(path) }.to_string_lossy().to_string();
+    let r = guarded(|| h.engine.add_voice(&name, Path::new(&path)));
+    match r {
+        Ok(()) => {
+            h.voice_blob = nul_separated(h.engine.voices());
+            true
+        }
+        Err(e) => {
+            h.last_error = Some(c_string(&e));
+            false
+        }
+    }
+}
